{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/thesis/configuration-c-response.schema.json",
  "title": "Configuration C fraud investigation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "risk_level",
    "self_reported_confidence",
    "citations",
    "claims",
    "model_drivers",
    "recommended_actions",
    "limitations"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "self_reported_confidence": {
      "type": "null",
      "description": "Null until a calibrated LLM answer-confidence method is implemented and validated."
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "citations"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "citations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "model_drivers": {
      "type": "array",
      "uniqueItems": true,
      "description": "Only feature or feature-group identifiers supplied by the model-attribution evidence.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
