# Copy to .env; both local Jira/Node launchers load it and .env is ignored by Git.
# Never commit a real email address or API token.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_USER_EMAIL=research-integration@example.com
# Recommended on macOS: leave this empty. run_node_ui.sh prompts once and stores the
# token in Keychain under JIRA_KEYCHAIN_SERVICE. A direct environment value is also
# supported for non-interactive execution.
JIRA_API_TOKEN=
JIRA_KEYCHAIN_SERVICE=thesis-fraud-jira-api-token
JIRA_PROJECT_KEY=FIR

# Jira REST writes also require the CLI's explicit --approve-write flag.
JIRA_ENABLE_WRITES=false

# Event-driven operational referral. Keep disabled for A/B/C experiments.
# When enabled, every newly persisted operational Configuration C detector alert
# automatically creates or reuses one Jira Story keyed by its model evidence ID.
JIRA_AUTO_REFERRAL_ENABLED=false
JIRA_AUTO_REFERRAL_APPROVED=false
JIRA_ULB_EPIC_KEY=FIR-1
JIRA_SPARKOV_EPIC_KEY=FIR-2

# The deterministic planner is the evaluated-safe default. The optional local Qwen
# planner remains fail-closed and needs separate sandbox evaluation.
JIRA_AUTO_PLANNER_ENGINE=rule
JIRA_AUTO_PLANNER_LOCAL_FILES_ONLY=true

# Optional bounded background monitoring in the same API process.
JIRA_AUTO_MONITOR_ENABLED=false
JIRA_AUTO_MONITOR_APPROVED=false
JIRA_AUTO_MONITOR_INTERVAL_MINUTES=60
